# 사전 데이터를 작성·검수하는 PostgreSQL 연결 문자열.
# 앱 런타임은 이 DB를 쓰지 않는다. 스키마 마이그레이션과 빌드 시 JSON 추출에만 쓰인다.
#
# Neon (https://console.neon.tech) → 프로젝트 생성 → Connection string 복사.
# 풀러 엔드포인트(호스트에 -pooler가 붙은 쪽)를 써도 되고 안 써도 된다.
# src/db/index.ts 가 prepare:false 로 열기 때문에 어느 쪽이든 동작한다.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/niben?sslmode=require"

# Gemini API 키. Google AI Studio (https://aistudio.google.com/apikey) 에서 발급한다.
# 두 곳에서 쓴다: 뜻 생성(npm run translate)과 앱의 답 채점 API(/api/check, 서버에서만 읽는다).
# 배포한 사이트에서 채점을 쓰려면 Vercel 환경 변수에도 넣어야 한다(vercel env add GEMINI_API_KEY production).
GEMINI_API_KEY="..."

# 채점에 쓸 모델. 쉼표로 여러 개를 적으면 앞에서부터 시도하고, 붐비거나 실패하면 다음 모델로 넘어간다.
# 비우면 src/lib/grading.ts 의 기본 순서(gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.5-flash-lite)를 쓴다.
# GEMINI_MODEL="gemini-3.5-flash,gemini-3.1-flash-lite"

# 로컬 Docker로 돌릴 때는 아래로 바꾼다.
#   docker run --name niben-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:17
#   docker exec -it niben-db createdb -U postgres niben
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niben"
